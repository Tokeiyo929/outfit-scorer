.wrap {
  padding: 24rpx;
  min-height: 100%;
  box-sizing: border-box;
}

.state {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.state-text {
  color: #8a867e;
  font-size: 26rpx;
}
.state-err {
  color: #d5442e;
  font-size: 22rpx;
}

/* ---------- 卡片流（与收藏页同款窗口） ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.cell {
  width: 48.5%;
  margin-bottom: 20rpx;
  padding: 0;
  overflow: hidden;
  position: relative;
}
.pic {
  width: 100%;
  height: 440rpx;
  display: block;
  background: #f0efeb;
}
.score-badge {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  min-width: 56rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(232, 97, 60, 0.9);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}
.ops {
  position: absolute;
  right: 10rpx;
  top: 6rpx;
  display: flex;
  gap: 4rpx;
}
.ops .op {
  font-size: 34rpx;
  padding: 6rpx 8rpx;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
}
.ops .op.del {
  color: #ffd7cf;
}
.info {
  padding: 10rpx 16rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.pair-line {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: wrap;
}
.dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 6rpx;
  background: #d8d5cd;
  flex-shrink: 0;
}
.pair-name {
  font-size: 24rpx;
  font-weight: 500;
}
.pair-x {
  font-size: 24rpx;
  color: #8a867e;
  margin: 0 2rpx;
}
.bad {
  font-size: 20rpx;
}
.date {
  font-size: 20rpx;
  color: #8a867e;
}
.comment {
  font-size: 20rpx;
  color: #2b2a28;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ---------- 编辑浮层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
  max-height: 85vh;
  overflow-y: auto;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  padding-bottom: 8rpx;
}
.field-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}
.field-label {
  font-size: 24rpx;
  color: #8a867e;
  width: 64rpx;
}
.field-slider {
  flex: 1;
  margin: 0;
}
.field-value {
  font-size: 32rpx;
  font-weight: 700;
  width: 80rpx;
  text-align: right;
}

.chip-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
}
.chip-title {
  font-size: 22rpx;
  color: #8a867e;
  width: 64rpx;
}
.chip {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f0efeb;
  color: #2b2a28;
}
.chip.on {
  background: #e8613c;
  color: #fff;
}

.comment-input {
  width: 100%;
  box-sizing: border-box;
  background: #f6f5f1;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  margin-top: 24rpx;
  min-height: 60rpx;
}

.photo-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}
.photo-btn {
  font-size: 26rpx;
  line-height: 72rpx;
  min-height: 72rpx;
  padding: 0 28rpx;
  width: auto;
}
.photo-preview {
  width: 96rpx;
  height: 96rpx;
  border-radius: 10rpx;
  background: #f0efeb;
}

.delete-link {
  display: block;
  color: #d5442e;
  font-size: 26rpx;
  margin-top: 28rpx;
}
.edit-err {
  display: block;
  color: #d5442e;
  font-size: 24rpx;
  margin-top: 14rpx;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.half-btn {
  flex: 1;
  font-size: 28rpx;
  line-height: 84rpx;
  min-height: 84rpx;
  padding: 0;
}

.work-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 300px;
}
