.wrap {
  padding: 24rpx;
  padding-bottom: 160rpx;
  min-height: 100%;
  box-sizing: border-box;
}

.state {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.state-text {
  color: #8a867e;
  font-size: 26rpx;
}
.state-hint {
  color: #b3afa7;
  font-size: 24rpx;
  text-align: center;
  padding: 0 60rpx;
}
.state-err {
  color: #d5442e;
  font-size: 22rpx;
}
.inline-err {
  display: block;
  text-align: center;
  margin-top: 16rpx;
}

/* ---------- 宫格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.cell {
  width: 48.5%;
  margin-bottom: 20rpx;
  padding: 0;
  overflow: hidden;
  position: relative;
}
.pic {
  width: 100%;
  height: 440rpx;
  display: block;
  background: #f0efeb;
}
.note {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 44rpx;
  padding: 10rpx 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.date {
  display: block;
  font-size: 20rpx;
  color: #8a867e;
  padding: 8rpx 16rpx 12rpx;
}

/* ---------- 悬浮添加按钮 ---------- */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #e8613c;
  color: #fff;
  font-size: 60rpx;
  line-height: 104rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(232, 97, 60, 0.4);
  z-index: 10;
}

/* ---------- 添加浮层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
  max-height: 85vh;
  overflow-y: auto;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  padding-bottom: 8rpx;
}
.preview {
  width: 100%;
  height: 560rpx;
  border-radius: 16rpx;
  background: #f0efeb;
  margin-top: 16rpx;
}
.note-input {
  width: 100%;
  box-sizing: border-box;
  background: #f6f5f1;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  margin-top: 24rpx;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.half-btn {
  flex: 1;
  font-size: 28rpx;
  line-height: 84rpx;
  min-height: 84rpx;
  padding: 0;
}

.work-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 300px;
}
